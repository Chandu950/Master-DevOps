#!/bin/bash

# 🏁 Step 1: Git repository initialize cheyyadam
git init

# 📁 Step 2: Sample file create cheyyadam
echo "This is a test file for Git workflow." > aws.txt

# 📥 Step 3: File ni staging area ki add cheyyadam
git add aws.txt

# 📝 Step 4: Commit cheyyadam with message
git commit -m "Initial commit for aws.txt"

# 📊 Step 5: Status chudadam (green = staged, red = working dir)
echo "🔍 Git Status:"
git status

# 📜 Step 6: Commit history chudadam
echo "📜 Git Log:"
git log --oneline

# 🔍 Step 7: Last commit ID ni capture cheyyadam
COMMIT_ID=$(git log -1 --pretty=format:"%H")

# 📂 Step 8: A commit lo yemi files change ayayo chudadam
echo "📂 Files changed in commit $COMMIT_ID:"
git show "$COMMIT_ID" --name-only
